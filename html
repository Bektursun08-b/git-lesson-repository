            if (methodInfo) {
                let html = `
                    <div class="flex items-center space-x-2 mb-3">
                        <span class="text-lg">${methodInfo.icon}</span>
                        <span class="font-semibold text-blue-800">${methodInfo.name}</span>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Получатель:</span>
                            <span class="font-semibold">${methodInfo.recipient}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Номер телефона:</span>
                            <span class="font-mono font-semibold text-green-600">${methodInfo.phone}</span>
                        </div>
                `;
                
                if (methodInfo.card) {
                    html += `
                        <div class="flex justify-between">
                            <span class="text-gray-600">Номер карты:</span>
                            <span class="font-mono font-semibold text-blue-600">${methodInfo.card}</span>
                        </div>
                    `;
                }
                
                html += `
                    </div>
                    <div class="mt-3 flex space-x-2">
                        <button onclick="copyToClipboard('${methodInfo.phone}')" class="flex-1 bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700">
                            Копировать номер
                        </button>
                `;
                
                if (methodInfo.card) {
                    html += `
                        <button onclick="copyToClipboard('${methodInfo.card}')" class="flex-1 bg-green-600 text-white px-3 py-1 rounded text-xs hover:bg-green-700">
                            Копировать карту
                        </button>
                    `;
                }
                
                html += '</div>';
                
                infoDiv.innerHTML = html;
                detailsDiv.classList.remove('hidden');
            }
        }
        
        // Копировать в буфер обмена
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                showNotification('Скопировано в буфер обмена!', 'success');
            }).catch(() => {
                // Fallback для старых браузеров
                const textArea = document.createElement('textarea');
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                showNotification('Скопировано в буфер обмена!', 'success');
            });
        }

        // Функции для пополнения и вывода
        function requestDeposit() {
            const amount = parseInt(document.getElementById('depositAmount').value);
            const method = document.getElementById('depositMethod').value;
            const phone = document.getElementById('depositPhone').value;

            if (!amount || amount < 700) {
                showNotification('Минимальная сумма пополнения 700 сом!', 'error');
                return;
            }

            if (!method) {
                showNotification('Выберите способ пополнения!', 'error');
                return;
            }

            if (!phone) {
                showNotification('Укажите номер телефона!', 'error');
                return;
            }

            const deposit = {
                id: Date.now(),
                userId: currentUser.id,
                userName: currentUser.name,
                userEmail: currentUser.email,
                amount: amount,
                method: method,
                phone: phone,
                date: new Date(),
                status: 'pending'
            };

            pendingDeposits.push(deposit);
            
            // Очищаем форму
            document.getElementById('depositAmount').value = '';
            document.getElementById('depositMethod').value = '';
            document.getElementById('depositPhone').value = '';

            showNotification(`Заявка на пополнение ${amount} сом подана! Ожидайте подтверждения администратора.`, 'success');
        }

        function requestWithdrawal() {
            const amount = parseInt(document.getElementById('withdrawAmount').value);
            const method = document.getElementById('withdrawMethod').value;
            const phone = document.getElementById('withdrawPhone').value;

            // Проверяем наличие VIP пакетов
            if (userVips.length === 0) {
                showNotification('Для вывода средств необходимо иметь хотя бы один VIP пакет!', 'error');
                return;
            }

            if (!amount || amount < 500) {
                showNotification('Минимальная сумма вывода 500 сом!', 'error');
                return;
            }

            if (amount > userBalance) {
                showNotification('Недостаточно средств на балансе!', 'error');
                return;
            }

            if (!method) {
                showNotification('Выберите способ вывода!', 'error');
                return;
            }

            if (!phone) {
                showNotification('Укажите номер телефона!', 'error');
                return;
            }

            const withdrawal = {
                id: Date.now(),
                userId: currentUser.id,
                userName: currentUser.name,
                userEmail: currentUser.email,
                amount: amount,
                method: method,
                phone: phone,
                date: new Date(),
                status: 'pending'
            };

            pendingWithdrawals.push(withdrawal);
            
            // Очищаем форму
            document.getElementById('withdrawAmount').value = '';
            document.getElementById('withdrawMethod').value = '';
            document.getElementById('withdrawPhone').value = '';

            showNotification(`Заявка на вывод ${amount} сом подана! Ожидайте обработки администратором.`, 'success');
        }

        // Админские функции для обработки заявок
        function approveDeposit(depositId) {
            const deposit = pendingDeposits.find(d => d.id === depositId);
            if (deposit) {
                deposit.status = 'approved';
                
                // Добавляем деньги пользователю
                const user = allUsers.find(u => u.id === deposit.userId);
                if (user) {
                    user.balance += deposit.amount;
                    user.totalDeposits += deposit.amount;
                    
                    // Если это текущий пользователь, обновляем его баланс
                    if (currentUser && currentUser.id === user.id) {
                        userBalance = user.balance;
                        updateBalance();
                    }
                }

                loadDepositsTable();
                loadUsersTable();
                showNotification(`Пополнение на ${deposit.amount} сом одобрено для ${deposit.userName}`, 'success');
            }
        }

        function rejectDeposit(depositId) {
            const deposit = pendingDeposits.find(d => d.id === depositId);
            if (deposit) {
                deposit.status = 'rejected';
                loadDepositsTable();
                showNotification(`Пополнение для ${deposit.userName} отклонено`, 'success');
            }
        }

        function approveWithdrawal(withdrawalId) {
            const withdrawal = pendingWithdrawals.find(w => w.id === withdrawalId);
            if (withdrawal) {
                withdrawal.status = 'approved';
                
                // Списываем деньги у пользователя
                const user = allUsers.find(u => u.id === withdrawal.userId);
                if (user) {
                    user.balance -= withdrawal.amount;
                    user.totalWithdrawals += withdrawal.amount;
                }

                loadWithdrawalsTable();
                loadUsersTable();
                showNotification(`Вывод ${withdrawal.amount} сом выплачен для ${withdrawal.userName}`, 'success');
            }
        }

        function rejectWithdrawal(withdrawalId) {
            const withdrawal = pendingWithdrawals.find(w => w.id === withdrawalId);
            if (withdrawal) {
                withdrawal.status = 'rejected';
                loadWithdrawalsTable();
                showNotification(`Вывод для ${withdrawal.userName} отклонен`, 'success');
            }
        }

