        // Система ежедневных доходов
        function startDailyIncomeSystem() {
            // Проверяем каждую минуту (в реальности можно каждый час)
            dailyIncomeInterval = setInterval(() => {
                const now = new Date();
                
                userVips.forEach(vip => {
                    if (vip.status === 'active' && now >= vip.startDate) {
                        // Проверяем, прошел ли день с последней выплаты
                        const lastPayment = vip.lastPayment || vip.startDate;
                        const hoursSinceLastPayment = (now - lastPayment) / (1000 * 60 * 60);
                        
                        // Для демонстрации выплачиваем каждые 2 минуты (в реальности каждые 24 часа)
                        if (hoursSinceLastPayment >= 0.033) { // 2 минуты = 0.033 часа
                            // Добавляем ежедневный доход
                            userBalance += vip.dailyIncome;
                            vip.totalEarned += vip.dailyIncome;
                            vip.lastPayment = now;
                            vip.daysLeft--;
                            
                            // Обновляем пользователя в базе
                            if (currentUser) {
                                currentUser.balance = userBalance;
                                const userIndex = allUsers.findIndex(u => u.id === currentUser.id);
                                if (userIndex !== -1) {
                                    allUsers[userIndex].balance = userBalance;
                                }
                            }
                            
                            // Проверяем, закончился ли срок
                            if (vip.daysLeft <= 0 || now >= vip.endDate) {
                                vip.status = 'completed';
                            }
                            
                            updateBalance();
                            updateMyVips();
                            
                            showNotification(`Получен доход: +${vip.dailyIncome} сом от VIP ${vip.level}`, 'success');
                        }
                    }
                });
            }, 60000); // Проверяем каждую минуту
        }



