        // VIP пакеты
        function buyVip(vipLevel, cost, dailyIncome) {
            // Проверяем VIP 1 - можно купить только один раз
            if (vipLevel === 1) {
                const hasVip1 = userVips.some(vip => vip.level === 1);
                if (hasVip1) {
                    showNotification('VIP 1 можно купить только один раз!', 'error');
                    return;
                }
            }

            if (userBalance < cost) {
                showNotification(`Недостаточно средств! Необходимо ${cost} сом.`, 'error');
                return;
            }

            // Покупаем VIP
            userBalance -= cost;
            const newVip = {
                id: Date.now(),
                level: vipLevel,
                cost: cost,
                dailyIncome: dailyIncome,
                purchaseDate: new Date(),
                startDate: new Date(Date.now() + 24 * 60 * 60 * 1000), // Начинает работать завтра
                endDate: new Date(Date.now() + 31 * 24 * 60 * 60 * 1000), // 30 дней + 1 день задержки
                status: 'active',
                totalEarned: 0,
                daysLeft: 30
            };

            userVips.push(newVip);
            
            // Обновляем пользователя в базе
            if (currentUser) {
                currentUser.balance = userBalance;
                const userIndex = allUsers.findIndex(u => u.id === currentUser.id);
                if (userIndex !== -1) {
                    allUsers[userIndex].balance = userBalance;
                }
            }

            updateBalance();
            updateDashboard();
            updateMyVips();
            updateVip1Button();
            
            showNotification(`VIP ${vipLevel} успешно куплен! Доходы начнут поступать завтра.`, 'success');
        }

