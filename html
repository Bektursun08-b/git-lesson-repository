        }

        function editUserBalance(userId) {
            const user = allUsers.find(u => u.id === userId);
            if (user) {
                const newBalance = prompt(`Текущий баланс: ${user.balance} сом\nВведите новый баланс:`, user.balance);
                if (newBalance !== null && !isNaN(newBalance)) {
                    user.balance = parseInt(newBalance);
                    
                    // Если это текущий пользователь, обновляем его баланс
                    if (currentUser && currentUser.id === userId) {
                        userBalance = user.balance;
                        updateBalance();
                    }
                    
                    loadUsersTable();
                    showNotification('Баланс пользователя обновлен', 'success');
                }
            }
        }

