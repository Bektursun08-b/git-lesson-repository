<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InvestPro - Инвестиционная платформа</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .card-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .balance-circle {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }
        .mobile-menu {
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }
        .mobile-menu.open {
            transform: translateX(0);
        }
        @media (max-width: 768px) {
            .desktop-sidebar {
                display: none;
            }
        }
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            padding: 15px;
            border-radius: 8px;
            color: white;
            font-weight: bold;
            opacity: 0;
            transform: translateX(100%);
            transition: all 0.3s ease;
        }
        .notification.show {
            opacity: 1;
            transform: translateX(0);
        }
        .notification.success {
            background-color: #10b981;
        }
        .notification.error {
            background-color: #ef4444;
        }
        .admin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Уведомления -->
    <div id="notification" class="notification"></div>

    <!-- Экран входа/регистрации -->
    <div id="authScreen" class="min-h-screen gradient-bg flex items-center justify-center">
        <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-w-md">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-800 mb-2">InvestPro</h1>
                <p class="text-gray-600">Ваша инвестиционная платформа</p>
            </div>
            
            <div id="loginForm">
                <h2 class="text-2xl font-semibold mb-6 text-center">Вход</h2>
                <div class="space-y-4">
                    <input type="email" id="loginEmail" placeholder="Email" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <input type="password" id="loginPassword" placeholder="Пароль" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <button onclick="login()" class="w-full bg-blue-600 text-white p-3 rounded-lg hover:bg-blue-700 transition duration-300">Войти</button>
                </div>
                <p class="text-center mt-4 text-gray-600">
                    Нет аккаунта? <button onclick="showRegister()" class="text-blue-600 hover:underline">Регистрация</button>
                </p>
                <div class="mt-4 p-3 bg-gray-100 rounded-lg text-sm">
                    <p class="font-semibold mb-2">Тестовые данные:</p>
                    <p><strong>Пользователь:</strong> user@test.com / user123</p>
                    <p class="text-xs text-gray-600 mt-1">Админ панель доступна только владельцу</p>
                </div>
            </div>
            
            <div id="registerForm" class="hidden">
                <h2 class="text-2xl font-semibold mb-6 text-center">Регистрация</h2>
                <div class="space-y-4">
                    <input type="text" id="regName" placeholder="Имя" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <input type="email" id="regEmail" placeholder="Email" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <input type="password" id="regPassword" placeholder="Пароль" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <input type="text" id="regReferral" placeholder="Реферальный код (необязательно)" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <button onclick="register()" class="w-full bg-green-600 text-white p-3 rounded-lg hover:bg-green-700 transition duration-300">Зарегистрироваться</button>
                </div>
                <p class="text-center mt-4 text-gray-600">
                    Уже есть аккаунт? <button onclick="showLogin()" class="text-blue-600 hover:underline">Войти</button>
                </p>
            </div>
        </div>
    </div>

    <!-- Главная панель -->
    <div id="mainApp" class="hidden min-h-screen bg-gray-50">
        <!-- Верхняя панель -->
        <header class="bg-white shadow-sm border-b">
            <div class="px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <div class="flex items-center">
                        <button onclick="toggleMobileMenu()" class="md:hidden mr-3 p-2">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                            </svg>
                        </button>
                        <h1 class="text-xl md:text-2xl font-bold text-gray-900">InvestPro</h1>
                    </div>
                    <div class="flex items-center space-x-2 md:space-x-4">
                        <div class="balance-circle text-white px-3 md:px-6 py-2 rounded-full">
                            <span class="font-semibold text-sm md:text-base">
                                <span class="hidden sm:inline">Баланс: </span><span id="userBalance">0</span> сом
                            </span>
                        </div>
                        <span id="userRole" class="text-sm bg-gray-200 px-2 py-1 rounded"></span>
                        <button onclick="logout()" class="text-gray-500 hover:text-gray-700 text-sm md:text-base">Выход</button>
                    </div>
                </div>
            </div>
        </header>

        <!-- Боковое меню -->
        <div class="flex relative">
            <!-- Desktop Sidebar -->
            <nav class="desktop-sidebar w-64 bg-white shadow-sm h-screen hidden md:block overflow-y-auto">
                <div class="p-4">
                    <ul class="space-y-2" id="sidebarMenu">
                        <!-- Меню будет заполнено динамически -->
                    </ul>
                </div>
            </nav>

            <!-- Mobile Menu Overlay -->
            <div id="mobileMenuOverlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden md:hidden" onclick="closeMobileMenu()"></div>
            
            <!-- Mobile Sidebar -->
            <nav id="mobileSidebar" class="mobile-menu fixed left-0 top-0 w-64 bg-white shadow-lg h-full z-50 md:hidden overflow-y-auto">
                <div class="p-4">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold">Меню</h2>
                        <button onclick="closeMobileMenu()" class="p-2">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <ul class="space-y-2" id="mobileSidebarMenu">
                        <!-- Меню будет заполнено динамически -->
                    </ul>
                </div>
            </nav>

            <!-- Основной контент -->
            <main class="flex-1 p-4 md:p-6 overflow-y-auto">
                <!-- Главная страница -->
                <div id="dashboard" class="section">
                    <h2 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6">Добро пожаловать!</h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-6 md:mb-8">
                        <div class="bg-white p-6 rounded-xl shadow-sm card-hover">
                            <h3 class="text-lg font-semibold mb-2">Общий баланс</h3>
                            <p class="text-3xl font-bold text-blue-600"><span id="dashBalance">0</span> сом</p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm card-hover">
                            <h3 class="text-lg font-semibold mb-2">Активные VIP</h3>
                            <p class="text-3xl font-bold text-green-600"><span id="activeInvestments">0</span></p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm card-hover">
                            <h3 class="text-lg font-semibold mb-2">Всего VIP</h3>
                            <p class="text-3xl font-bold text-purple-600"><span id="referralCount">0</span></p>
                        </div>
                    </div>
                </div>

                <!-- VIP пакеты -->
                <div id="vips" class="section hidden">
                    <!-- Пополнение и вывод -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white p-6 rounded-xl shadow-sm">
                            <h3 class="text-xl font-semibold mb-4 text-green-600">💰 Пополнить баланс</h3>
                            <div class="space-y-4">
                                <input type="number" id="depositAmount" placeholder="Сумма (мин. 700 сом)" class="w-full p-3 border border-gray-300 rounded-lg">
                                <select id="depositMethod" onchange="showPaymentDetails()" class="w-full p-3 border border-gray-300 rounded-lg">
                                    <option value="">Выберите способ</option>
                                    <option value="elsom">Элсом</option>
                                    <option value="odengi">О!Деньги</option>
                                    <option value="megapay">MegaPay</option>
                                    <option value="mbank">МБанк</option>
                                    <option value="optima">Оптима Банк</option>
                                </select>
                                
                                <!-- Детали для перевода -->
                                <div id="paymentDetails" class="hidden bg-blue-50 p-4 rounded-lg border border-blue-200">
                                    <h4 class="font-semibold text-blue-800 mb-2">📋 Реквизиты для перевода:</h4>
                                    <div id="paymentInfo" class="space-y-2 text-sm">
                                        <!-- Информация будет заполнена динамически -->
                                    </div>
                                    <div class="mt-3 p-2 bg-yellow-100 rounded border border-yellow-300">
                                        <p class="text-xs text-yellow-800">
                                            ⚠️ <strong>Важно:</strong> После перевода обязательно подайте заявку ниже с указанием суммы и вашего номера телефона!
                                        </p>
                                    </div>
                                </div>
                                
                                <input type="tel" id="depositPhone" placeholder="Ваш номер телефона" class="w-full p-3 border border-gray-300 rounded-lg">
                                <button onclick="requestDeposit()" class="w-full bg-green-600 text-white p-3 rounded-lg hover:bg-green-700 transition duration-300">Подать заявку на пополнение</button>
                            </div>
                        </div>
                        
                        <div class="bg-white p-6 rounded-xl shadow-sm">
                            <h3 class="text-xl font-semibold mb-4 text-red-600">💸 Вывести средства</h3>
                            <div class="space-y-4">
                                <input type="number" id="withdrawAmount" placeholder="Сумма (мин. 500 сом)" class="w-full p-3 border border-gray-300 rounded-lg">
                                <select id="withdrawMethod" class="w-full p-3 border border-gray-300 rounded-lg">
                                    <option value="">Выберите способ</option>
                                    <option value="elsom">Элсом</option>
                                    <option value="odengi">О!Деньги</option>
                                    <option value="megapay">MegaPay</option>
                                    <option value="mbank">МБанк</option>
                                    <option value="optima">Оптима Банк</option>
                                </select>
                                <input type="tel" id="withdrawPhone" placeholder="Ваш номер телефона/карты" class="w-full p-3 border border-gray-300 rounded-lg">
                                
                                <div class="bg-yellow-50 p-4 rounded-lg border border-yellow-200">
                                    <h4 class="font-semibold text-yellow-800 mb-2">ℹ️ Информация о выводе:</h4>
                                    <div class="text-sm text-yellow-700 space-y-1">
                                        <p>• Минимальная сумма вывода: <strong>500 сом</strong></p>
                                        <p>• Время обработки: <strong>от 1 до 24 часов</strong></p>
                                        <p>• Комиссия: <strong>0%</strong></p>
                                        <p>• <strong>Важно:</strong> Для вывода нужно иметь хотя бы один VIP пакет!</p>
                                    </div>
                                </div>
                                
                                <button onclick="requestWithdrawal()" class="w-full bg-red-600 text-white p-3 rounded-lg hover:bg-red-700 transition duration-300">Подать заявку на вывод</button>
                            </div>
                        </div>
                    </div>

                    <h2 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6">VIP пакеты</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                        <div class="bg-white p-6 rounded-xl shadow-sm card-hover border-2 border-blue-200">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-xl font-semibold text-blue-600">💎 VIP 1</h3>
                                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-xs">Только один раз</span>
                            </div>
                            <div class="mb-4">
                                <p class="text-gray-600">Стоимость: <span class="font-semibold text-2xl text-blue-600">700 сом</span></p>
                                <p class="text-gray-600">Ежедневный доход: <span class="font-semibold text-green-600">95 сом</span></p>
                                <p class="text-gray-600">Срок: <span class="font-semibold">30 дней</span></p>
                                <p class="text-gray-600">Общий доход: <span class="font-semibold text-green-600">2,850 сом</span></p>
                            </div>
                            <button onclick="buyVip(1, 700, 95)" class="w-full bg-blue-600 text-white p-3 rounded-lg hover:bg-blue-700 transition duration-300" id="vip1Btn">Купить VIP 1</button>
                        </div>
                        
                        <div class="bg-white p-6 rounded-xl shadow-sm card-hover border-2 border-green-200">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-xl font-semibold text-green-600">💎 VIP 2</h3>
                                <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs">Многоразовый</span>
                            </div>
                            <div class="mb-4">
                                <p class="text-gray-600">Стоимость: <span class="font-semibold text-2xl text-green-600">2,000 сом</span></p>
                                <p class="text-gray-600">Ежедневный доход: <span class="font-semibold text-green-600">150 сом</span></p>
                                <p class="text-gray-600">Срок: <span class="font-semibold">30 дней</span></p>
                                <p class="text-gray-600">Общий доход: <span class="font-semibold text-green-600">4,500 сом</span></p>
                            </div>
                            <button onclick="buyVip(2, 2000, 150)" class="w-full bg-green-600 text-white p-3 rounded-lg hover:bg-green-700 transition duration-300">Купить VIP 2</button>
                        </div>
                        
                        <div class="bg-white p-6 rounded-xl shadow-sm card-hover border-2 border-purple-200">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-xl font-semibold text-purple-600">💎 VIP 3</h3>
                                <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded-full text-xs">Многоразовый</span>
                            </div>
                            <div class="mb-4">
                                <p class="text-gray-600">Стоимость: <span class="font-semibold text-2xl text-purple-600">4,000 сом</span></p>
                                <p class="text-gray-600">Ежедневный доход: <span class="font-semibold text-green-600">200 сом</span></p>
                                <p class="text-gray-600">Срок: <span class="font-semibold">30 дней</span></p>
                                <p class="text-gray-600">Общий доход: <span class="font-semibold text-green-600">6,000 сом</span></p>
                            </div>
                            <button onclick="buyVip(3, 4000, 200)" class="w-full bg-purple-600 text-white p-3 rounded-lg hover:bg-purple-700 transition duration-300">Купить VIP 3</button>
                        </div>
                    </div>
                    
                    <div class="mt-8">
                        <h3 class="text-2xl font-semibold mb-4">Мои VIP пакеты</h3>
                        <div id="myVips" class="bg-white rounded-xl shadow-sm p-6">
                            <p class="text-gray-500">У вас пока нет активных VIP пакетов</p>
                        </div>
                    </div>
                </div>



                <!-- Профиль -->
                <div id="profile" class="section hidden">
                    <h2 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6">Профиль</h2>
                    <div class="bg-white p-6 rounded-xl shadow-sm">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Имя</label>
                                <input type="text" id="profileName" class="w-full p-3 border border-gray-300 rounded-lg">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                <input type="email" id="profileEmail" class="w-full p-3 border border-gray-300 rounded-lg">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Телефон</label>
                                <input type="tel" id="profilePhone" placeholder="+996 XXX XXX XXX" class="w-full p-3 border border-gray-300 rounded-lg">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Город</label>
                                <select id="profileCity" class="w-full p-3 border border-gray-300 rounded-lg">
                                    <option value="">Выберите город</option>
                                    <option value="bishkek">Бишкек</option>
                                    <option value="osh">Ош</option>
                                    <option value="jalal-abad">Жалал-Абад</option>
                                    <option value="karakol">Каракол</option>
                                    <option value="tokmok">Токмок</option>
                                </select>
                            </div>
                            <button onclick="updateProfile()" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-300">Сохранить изменения</button>
                        </div>
                    </div>
                </div>

                <!-- АДМИН ПАНЕЛЬ (только для админов) -->
                <div id="admin" class="section hidden" style="display: none;">
                    <h2 class="text-2xl md:text-3xl font-bold mb-6">Админ панель</h2>
                    
                    <!-- Быстрая статистика -->
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                        <div class="bg-white p-6 rounded-xl shadow-sm">
                            <h3 class="text-sm font-medium text-gray-500">Всего пользователей</h3>
                            <p class="text-3xl font-bold text-blue-600" id="totalUsers">0</p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm">
                            <h3 class="text-sm font-medium text-gray-500">Активные инвестиции</h3>
                            <p class="text-3xl font-bold text-green-600" id="totalInvestments">0</p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm">
                            <h3 class="text-sm font-medium text-gray-500">Общая сумма</h3>
                            <p class="text-3xl font-bold text-purple-600" id="totalAmount">0</p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm">
                            <h3 class="text-sm font-medium text-gray-500">Доход сегодня</h3>
                            <p class="text-3xl font-bold text-orange-600" id="todayIncome">0</p>
                        </div>
                    </div>

                    <!-- Админ навигация -->
                    <div class="bg-white rounded-xl shadow-sm mb-6">
                        <div class="border-b border-gray-200">
                            <nav class="-mb-px flex space-x-8 px-6 overflow-x-auto" id="adminTabs">
                                <button onclick="showAdminTab('analytics')" class="admin-tab-btn py-4 px-1 border-b-2 border-blue-500 font-medium text-sm text-blue-600 whitespace-nowrap">Аналитика</button>
                                <button onclick="showAdminTab('users')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Пользователи</button>
                                <button onclick="showAdminTab('deposits')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Пополнения</button>
                                <button onclick="showAdminTab('withdrawals')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Выводы</button>
                                <button onclick="showAdminTab('cards')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Карты</button>
                                <button onclick="showAdminTab('marketing')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Маркетинг</button>
                                <button onclick="showAdminTab('finance')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Финансы</button>
                                <button onclick="showAdminTab('security')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Безопасность</button>
                                <button onclick="showAdminTab('settings')" class="admin-tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 whitespace-nowrap">Настройки</button>
                            </nav>
                        </div>
                    </div>

                    <!-- Аналитика -->
                    <div id="adminAnalytics" class="admin-tab-content">
                        <div class="admin-grid mb-8">
                            <div class="bg-white p-6 rounded-xl shadow-sm">
                                <h3 class="text-lg font-semibold mb-4">Статистика по дням</h3>
                                <canvas id="dailyChart" width="400" height="200"></canvas>
                            </div>
                            <div class="bg-white p-6 rounded-xl shadow-sm">
                                <h3 class="text-lg font-semibold mb-4">Инвестиции по планам</h3>
                                <canvas id="plansChart" width="400" height="200"></canvas>
                            </div>
                            <div class="bg-white p-6 rounded-xl shadow-sm">
                                <h3 class="text-lg font-semibold mb-4">География пользователей</h3>
                                <div id="geoStats" class="space-y-2">
                                    <div class="flex justify-between"><span>Бишкек:</span><span class="font-semibold">45%</span></div>
                                    <div class="flex justify-between"><span>Ош:</span><span class="font-semibold">25%</span></div>
                                    <div class="flex justify-between"><span>Жалал-Абад:</span><span class="font-semibold">15%</span></div>
                                    <div class="flex justify-between"><span>Другие:</span><span class="font-semibold">15%</span></div>
                                </div>
