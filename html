        }

        function toggleUserStatus(userId) {
            const user = allUsers.find(u => u.id === userId);
            if (user) {
                user.status = user.status === 'active' ? 'blocked' : 'active';
                loadUsersTable();
                showNotification(`Пользователь ${user.status === 'active' ? 'разблокирован' : 'заблокирован'}`, 'success');
